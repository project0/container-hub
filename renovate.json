{
  "enabled": true,
  "extends": ["config:recommended", ":rebaseStalePrs"],
  "packageRules": [
    {
      "enabled": true,
      "automerge": true,
      "matchDatasources": ["docker"],
      "versioning": "regex:^(?<major>\\d+)(-(?<minor>\\d+))?$",
      "groupName": "base images",
      "groupSlug": "base-images",
      "matchPackageNames": [
        "ghcr.io/project0/container-hub/{/,}**"
      ]
    },
    {
      "enabled": true,
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["minor"]
    },
    {
      "enabled": true,
      "matchDatasources": ["github-releases"]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/|\\.)Dockerfile$/"],
      "matchStrings": ["# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)( versioning=(?<versioning>[^\\s]+?))?\\s+.*VERSION=[\"']?(?<currentValue>[^\"'\\s]+)"],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    }
  ]
}
